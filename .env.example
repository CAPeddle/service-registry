# Service Registry Configuration

# Application Settings
APP_NAME="Service Registry"
VERSION="0.1.0"
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=sqlite:///./service_registry.db

# API Settings
API_PREFIX=/api/v1

# Health Check Settings
HEALTH_CHECK_TIMEOUT=2.0
HEALTH_CHECK_CACHE_TTL=60

# Security: extra host names accepted on write requests (comma-separated).
# IP addresses, names without dots, .local names and the tailnet MagicDNS
# name are always accepted.
TRUSTED_HOSTS=
